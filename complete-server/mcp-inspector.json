{
    "mcpServers": {
        "devops-complete-server": {
            "command": "uv",
            "args": ["run", "mcp", "run", "server.py"],
            "env": {
                "MCP_TRANSPORT": "stdio",
                "MCP_SIGNING_MODE": "local",
                "MCP_SIGNING_KEY_PATH": "keys/dev-signing-key.pem",
                "MCP_ENVIRONMENT": "development"
            },
            "protocolEra": "modern"
        }
    }
}