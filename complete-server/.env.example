# Variables necesarias de GitHub

GITHUB_TOKEN="Example-Token"
GITHUB_API_URL="https://api.github.com"
GITHUB_API_VERSION=2026-03-10

# Variables necesarias de GitLab

GITLAB_TOKEN=replace-with-a-read-only-token
GITLAB_API_URL=https://gitlab.com/api/v4

# Variable Jenkins

JENKINS_URL=http://localhost:8080
JENKINS_USER=replace-with-a-read-only-user
JENKINS_TOKEN=replace-with-an-api-token